{
  "name": "earshot-workspace",
  "version": "1.0.0",
  "description": "Workspace root. The published package is packages/cli.",
  "homepage": "https://github.com/henrilhos/earshot#readme",
  "bugs": "https://github.com/henrilhos/earshot/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henrilhos/earshot.git"
  },
  "license": "MIT",
  "author": "Henrique de Castilhos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "auth": "node packages/cli/src/auth.ts",
    "start": "node packages/cli/src/index.ts",
    "typecheck": "tsc",
    "test": "npm run test --workspaces --if-present",
    "verify:core": "node scripts/verify-core.js",
    "verify:deps": "node scripts/verify-deps.js"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}

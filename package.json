{
  "name": "earshot",
  "version": "1.0.0",
  "description": "Mirror a Last.fm user's now-playing track into your Spotify queue, once per new track.",
  "keywords": [
    "lastfm",
    "last-fm",
    "lastfm-api",
    "spotify",
    "spotify-api",
    "spotify-queue",
    "now-playing",
    "nowplaying",
    "scrobble",
    "scrobbler",
    "music",
    "typescript",
    "nodejs",
    "cli"
  ],
  "homepage": "https://github.com/henrilhos/earshot#readme",
  "bugs": "https://github.com/henrilhos/earshot/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henrilhos/earshot.git"
  },
  "license": "MIT",
  "author": "Henrique de Castilhos",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "auth": "node src/auth.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc",
    "test": "node --test \"packages/**/*.test.ts\"",
    "verify:core": "node scripts/verify-core.js"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}

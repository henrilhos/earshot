# Last.fm: reads the recent tracks of the user you name on the command line.
# Free key, no OAuth: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key

# Spotify: your own account, the one tracks get queued into.
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Has to match a Redirect URI on the app character for character.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Encrypts your Spotify refresh token inside earshot.db. Thirty-two random
# bytes, base64. Leave it empty and the next run prints one to paste in here.
EARSHOT_SECRET_KEY=

# How often to poll Last.fm.
POLL_INTERVAL_MS=60000

# --- Last.fm (the person you're mirroring) ---
# Get a free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key
# The Last.fm USERNAME of the person whose scrobbles you want to mirror.
# No auth needed for this - recent tracks are public.
LASTFM_TARGET_USER=their_lastfm_username

# --- Spotify (your account - this is what gets queued into) ---
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Must EXACTLY match a Redirect URI registered on your Spotify app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Polling ---
# Last.fm: 1 request per 30s as requested. Don't go lower than ~1/sec (Last.fm ToS).
POLL_INTERVAL_MS=30000

{
  "name": "earshot-workspace",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "earshot-workspace",
      "version": "1.0.0",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "devDependencies": {
        "@types/node": "^24.3.0",
        "typescript": "^5.9.2"
      },
      "engines": {
        "node": ">=22.18"
      }
    },
    "apps/web": {

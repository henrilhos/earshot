{
  "name": "earshot",
  "version": "1.0.0",
  "description": "Mirror a Last.fm user's now-playing track into your Spotify queue, once per new track.",
  "keywords": [
    "lastfm",
    "last-fm",
    "lastfm-api",
    "spotify",
    "spotify-api",
    "spotify-queue",
    "now-playing",
    "nowplaying",
    "scrobble",
    "scrobbler",
    "music",
    "typescript",
    "nodejs",
    "cli"
  ],
  "homepage": "https://github.com/henrilhos/earshot#readme",
  "bugs": "https://github.com/henrilhos/earshot/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henrilhos/earshot.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Henrique de Castilhos",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "earshot": "dist/src/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "auth": "node src/auth.ts",
    "start": "node src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "node ../../scripts/vendor-core.js vendor && npm run build",
    "postpack": "node ../../scripts/vendor-core.js link"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
